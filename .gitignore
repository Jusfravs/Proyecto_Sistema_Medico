# Entornos virtuales
venv/
.venv/
*/venv/
*/.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Variables de entorno y secretos
.env
*/.env

# Bases de datos locales (el stub SQLite y cualquier .db de demo)
*.db
*.sqlite3

# Subidas de usuario (se conserva la carpeta, no su contenido)
vectra_cure/static/uploads/*
!vectra_cure/static/uploads/.gitkeep

# Editores / SO
# Se comparte la configuración común del equipo (intérprete, pruebas, F5)
# pero no los archivos personales de cada quien.
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
