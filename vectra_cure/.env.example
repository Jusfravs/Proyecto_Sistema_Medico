# Copia este archivo como `.env` y ajusta los valores.

SECRET_KEY=vectra-cure-clave-desarrollo-2026
APP_DEBUG=false

# ── Base de datos (la define el compañero de BD) ────────────────────
# Opción A: URL completa de PostgreSQL.
# DATABASE_URL=postgresql+psycopg://postgres:TU_CLAVE@localhost:5432/vectra_cure
#
# Opción B: piezas sueltas para PostgreSQL.
# DB_DIALECT=postgresql+psycopg
# DB_USER=postgres
# DB_PASSWORD=TU_CLAVE
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=vectra_cure
#
# La aplicación requiere PostgreSQL. SQLite se utiliza solo dentro de tests/.
